{
  "name": "claudehub",
  "version": "0.1.0",
  "description": "Monitor local de tokens de Claude Code: dashboard, mascota flotante y alertas de contexto para Windows.",
  "author": "Norman Smith Martínez Acevedo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NormanSMA/ClaudeHub.git"
  },
  "homepage": "https://github.com/NormanSMA/ClaudeHub#readme",
  "bugs": {
    "url": "https://github.com/NormanSMA/ClaudeHub/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "tokens",
    "monitor",
    "dashboard",
    "electron",
    "windows",
    "context-window"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "main": "src/tray/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "scan": "tsx src/core/cli.ts",
    "test": "vitest run",
    "tray": "electron .",
    "demo": "cross-env CLAUDEHUB_DEMO=1 tsx src/server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
