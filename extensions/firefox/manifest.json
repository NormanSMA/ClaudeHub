{
  "manifest_version": 3,
  "name": "ClaudeHub",
  "version": "0.1.0",
  "description": "Limites de tu plan y chats activos de Claude Code, desde tu servidor local de ClaudeHub.",
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1:4317/*"],
  "background": { "scripts": ["shared.js", "background.js"] },
  "browser_specific_settings": {
    "gecko": { "id": "claudehub@normansma.github.io", "strict_min_version": "115.0" }
  },
  "action": {
    "default_title": "ClaudeHub",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
